<div class="table-responsive">
    <table class="table">
        <thead class="border-bottom border-dark">
            <tr>
                <th scope="col">#</th>
                <th scope="col">{{ 'ui.genre'|trans }}</th>
                <th scope="col">{{ 'ui.title'|trans }}</th>
                <th scope="col">{{ 'ui.cast'|trans }}</th>
                <th scope="col">{{ 'ui.year'|trans }}</th>
            </tr>
        </thead>
        <tbody class="accordion" id="tableAccordion">
            {% for movie in movies %}
            <tr data-bs-toggle="collapse" data-bs-target="#row{{ movie.index }}" aria-expanded="false"
                aria-controls="row{{ movie.index }}" style="cursor: pointer;">
                <td>
                    <i class="bi bi-chevron-down toggle-icon"></i><b class="mx-3">{{ movie.index }}</b>
                </td>
                <td>{{ movie.genre }}</td>
                <td>{{ movie.title }}</td>
                <td>{{ movie.actors }}</td>
                <td>{{ movie.year }}</td>
            </tr>
            <tr>
                <td colspan="5" class="p-0 border-0">
                    {{ include('product/_video.html.twig', {'movie': movie, 'view': 'table'}) }}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>


{% if view == 'table' %}
    <div class="d-flex justify-content-center">
        {{ knp_pagination_render(movies, '@KnpPaginator/Pagination/bootstrap_v5_pagination.html.twig') }}
    </div>
{% endif %}
