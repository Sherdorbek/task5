<turbo-frame id="my-frame" refresh="morph">
    <div class="d-flex flex-row flex-wrap pt-4 justify-content-center" id="product-list">
        {% for movie in movies %}
        {% set hue1 = ((movie.trailer.intro * 37) % 360) %}
        {% set hue2 = ((movie.trailer.outro * 53) % 360) %}
        <div class="card m-2" style="width: 20rem; overflow: hidden;">
            <div class="card-img-top d-flex align-items-center justify-content-center text-center p-3 text-white fw-bold"
                style="height: 180px; background: linear-gradient(135deg, hsl({{ hue1 }}, 75%, 25%), hsl({{ hue2 }}, 80%, 45%)); font-size: 1.25rem; text-shadow: 0 2px 4px rgba(0,0,0,0.6);">
                <span>{{ movie.title }}</span>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-muted">{{ movie.year }}</span>
                    <div class="bg-primary text-light rounded px-2 py-1">
                        <i class="bi bi-hand-thumbs-up-fill me-1"></i>
                        <span class="like-val-{{ movie.index - 1 }}" data-like-idx="{{ movie.index - 1 }}">0</span>
                    </div>
                </div>
                <button type="button" class="btn btn-primary" data-bs-toggle="modal"
                    data-bs-target="#modal-{{ movie.index }}">
                    {{ 'ui.open'|trans }}
                </button>
            </div>
        </div>

        <div class="modal fade" id="modal-{{ movie.index }}" tabindex="-1"
            aria-labelledby="modalLabel-{{ movie.index }}" aria-hidden="true">
            <div class="modal-dialog modal-dialog-scrollable modal-dialog-centered modal-xl">
                <div class="modal-content">
                    <div class="modal-body p-0 position-relative">
                        {% include 'product/_video.html.twig' with {'movie': movie, 'view': 'grid'} %}
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" onclick="this.blur()">{{ 'ui.close'|trans }}</button>
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>

    <center>
        <form data-turbo-frame="my-frame" method="get" action="{{path('product_list')}}">
            <input value="{{page+1}}" name="page" type="hidden">
            <button type="submit" class="btn btn-primary">{{ 'ui.load_more'|trans }}</button>
        </form>
    </center>
</turbo-frame>