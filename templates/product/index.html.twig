{% extends 'base.html.twig' %}

{% block title %}Hello HomeController!{% endblock %}

{% block body %}
<div class="py-2" style="background-color: #e1e4e6">
    <div class="d-flex justify-content-around">
        <div class="row align-items-center">
            <div class="col">
                <div class="form-floating">
                    <select class="form-select" id="language" aria-label="Language">
                        <option value="1" selected>English</option>
                        <option value="2">Spain</option>
                    </select>
                    <label for="language">Language</label>
                </div>
            </div>
            <div class="col pt-3">
                <form method="POST" action="{{path('product_seed')}}">
                    <div class="input-group mb-3">
                        <div class="form-floating">
                            <input name="seed" id="seed" type="text" class="form-control" aria-label="seed"
                                value="{{seed}}">
                            <label for="seed">Seed</label>
                        </div>
                        <span class="input-group-text">
                            <button type="submit" class="btn bg-transparent">Shuffle</button>
                        </span>
                    </div>
                </form>
            </div>
            <div class="col position-relative" data-controller="like">
                <div class="d-flex justify-content-start">
                    <label for="range1" class="form-label mb-0" data-like-target="output">Likes </label>
                </div>
                <input type="range" min="0" max="10" step="0.1" class="form-range" id="range1" data-like-target="slider"
                    data-action="input->like#update">
            </div>
            <div class="col">
                <div class="form-floating">
                    <input type="number" class="form-control" id="review">
                    <label for="review">Review</label>
                </div>
            </div>
        </div>
        <div class="d-flex align-items-center">
            <form method="post" action="{{path('product_view')}}">
                <div class="btn-group" role="group">
                    {% if view == 'table' %}
                    <button name="view" value="table" type="submit" class="btn btn-primary">Table</button>
                    <button name="view" value="grid" type="submit" class="btn btn-outline-primary">Grid</button>
                    {% else %}
                    <button name="view" value="table" type="submit" class="btn btn-outline-primary">Table</button>
                    <button name="view" value="grid" type="submit" class="btn btn-primary">Grid</button>
                    {% endif %}
                </div>
        </div>
    </div>
    </form>
</div>

{% if view == 'table' %}
{{ include('product/_table.html.twig') }}
{% else %}
{{ include('product/_grid.html.twig') }}
{% endif %}


{% endblock %}
